{
  "uid": "flexpay-canary",
  "title": "FlexPay Canary · Transaction Engine",
  "tags": [
    "flexpay",
    "canary",
    "payments"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Prometheus alerts",
      "type": "link",
