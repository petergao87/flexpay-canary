      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Promotion and rollback policy",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Freeze promotion** until canary has **≥ 100 requests / 5 minutes**, all three scrape targets are UP, and stable/canary telemetry is present. **Rollback** when v2.0 5xx **> 1%** or stable + **2 percentage points**, or P95 **> 400 ms**, sustained **3 minutes**. Backend/target loss does not wait for the sample gate. Read `/alerts` in Prometheus; these rules do not send external notifications. Synthetic authorization outcomes are a demonstration KPI."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Canary samples / 5m",
      "description": "Prometheus increase is extrapolated. Values can be fractional. Promotions need at least 100 canary requests; low sample counts cannot prove health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flexpay:requests:increase5m{version=\"v2.0\"}",
          "legendFormat": "{{version}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
